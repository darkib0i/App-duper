<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Needed to list every launchable app so the user can pick what to dupe -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- Needed to install cloned APKs and remove them again -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- Signature-protected permission so only App Duper itself can talk across profiles -->
    <permission
        android:name="com.darkib.appduper.BRIDGE"
        android:protectionLevel="signature" />
    <uses-permission android:name="com.darkib.appduper.BRIDGE" />

    <application
        android:name=".AppDuperApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppDuper">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.AppDuper">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Invisible activity that runs inside the work profile and executes
             clone / remove commands forwarded from the main profile. -->
        <activity
            android:name=".bridge.ProfileBridgeActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:permission="com.darkib.appduper.BRIDGE"
            android:theme="@style/Theme.AppDuper.Invisible">
            <intent-filter>
                <action android:name="com.darkib.appduper.action.BRIDGE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Provisioning-mode + policy-compliance screens required by Android 12+
             during work profile setup. -->
        <activity
            android:name=".admin.ProvisioningActivity"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:theme="@style/Theme.AppDuper">
            <intent-filter>
                <action android:name="android.app.action.GET_PROVISIONING_MODE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.app.action.ADMIN_POLICY_COMPLIANCE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Receives PackageInstaller session status for clone install/uninstall. -->
        <receiver
            android:name=".install.InstallReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.darkib.appduper.INSTALL_STATUS" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".admin.DuperAdmin"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
                <action android:name="android.app.action.PROFILE_PROVISIONING_COMPLETE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
